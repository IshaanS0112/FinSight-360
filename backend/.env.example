# Copy to backend/.env for local (non-Docker) runs. docker-compose sets these itself.

DATABASE_URL=postgresql+psycopg2://finsight:finsight@localhost:5432/finsight360
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional. Without it, insight reports use the deterministic template fallback:
# every ratio, Z-score and health score is identical, only the prose is missing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Point at your own sourced reference bands. The shipped defaults are
# ILLUSTRATIVE PLACEHOLDERS - see backend/app/services/benchmarks.py.
REFERENCE_BENCHMARKS_PATH=

# Every coefficient and cutoff is overridable, and GET /methodology reports the
# values actually in force. Change them only with a reason you can defend:
# Z1968_C3=3.3
# ZDPRIME_SAFE_ABOVE=2.60
# HEALTH_W_PROFITABILITY=0.35

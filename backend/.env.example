# Copy to backend/.env for local (non-Docker) runs. docker-compose sets these itself.

DATABASE_URL=postgresql+psycopg2://finsight:finsight@localhost:5432/finsight360
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional. Without it, insight reports use the deterministic template fallback:
# every ratio, Z-score and health score is identical, only the prose is missing.
# ANTHROPIC_MODEL is the model ID to call; both must be set for model-written prose.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Point at your own sourced reference bands. The shipped defaults are
# ILLUSTRATIVE PLACEHOLDERS - see backend/app/services/benchmarks.py.
REFERENCE_BENCHMARKS_PATH=

# Every coefficient and cutoff is overridable, and GET /methodology reports the
# values actually in force. Change them only with a reason you can defend:
# Z1968_C3=3.3
# ZDPRIME_SAFE_ABOVE=2.60
# HEALTH_W_PROFITABILITY=0.35

# --- V2 ---------------------------------------------------------------------
# Ohlson's nine logit coefficients, and the probability above which the model
# predicts distress. OHLSON_SIZE weights ln(total_assets) - see the SIZE
# substitution note in docs/architecture.md before changing anything here.
# OHLSON_TLTA=6.03
# OHLSON_DISTRESS_PROBABILITY=0.5

# The two bands either side of "the models disagree". Asymmetric on purpose:
# clearing a distressed borrower costs more than flagging a healthy one.
# CONSENSUS_LOW_RISK_PROBABILITY=0.30
# CONSENSUS_HIGH_RISK_PROBABILITY=0.50

# Beneish's own cutoff and the stricter one commonly cited in later work. Both
# verdicts are reported; neither is promoted to "the" threshold.
# BENEISH_THRESHOLD=-1.78
# BENEISH_STRICT_THRESHOLD=-2.22

# DCF defaults. Every one is overridable per request and echoed back in the
# stored assumptions - these are starting points, not constants. Set the
# risk-free rate to your own market's sovereign yield before quoting anything.
# DCF_RISK_FREE_RATE=0.045
# DCF_EQUITY_RISK_PREMIUM=0.055
# DCF_DEFAULT_BETA=1.0
# DCF_TERMINAL_GROWTH=0.025
# DCF_PROJECTION_YEARS=5
# The minimum gap between WACC and terminal growth below which the Gordon
# terminal value is refused rather than reported.
# DCF_MIN_WACC_TERMINAL_SPREAD=0.01

# Monte Carlo. The seed is stored on every run: a distribution that cannot be
# regenerated exactly is an anecdote.
# SCENARIO_DEFAULT_TRIALS=5000
# SCENARIO_MAX_TRIALS=20000
# SCENARIO_DEFAULT_SEED=20240101
